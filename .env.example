# ---------------------------------------------------------------------------
# Web Game Center - Backend environment variables
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string.
# Local example:   mongodb://127.0.0.1:27017/game-center
# Atlas example:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/game-center?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/game-center

# JWT configuration
# Generate a strong secret, e.g:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Password hashing
BCRYPT_SALT_ROUNDS=12

# CORS (comma-separated list of allowed origins, or * for all)
CORS_ORIGIN=*
