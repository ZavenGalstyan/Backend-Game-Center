# ---------------------------------------------------------------------------
# Web Game Center - Backend environment variables
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local). Required.
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/game_center?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/game_center
# If no database name is included in the URI, "game_center" is used automatically.
MONGO_URI=

# JWT configuration. JWT_SECRET is required.
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Password hashing (bcrypt cost factor)
BCRYPT_SALT_ROUNDS=12

# Frontend / CORS origin(s): comma-separated list, or * for all
CORS_ORIGIN=*
